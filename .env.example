# Copy this file to `.env` and fill in the required values.
# PostgreSQL (>= 15) connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign and verify customer/admin session cookies (use a long random string).
AUTH_SECRET="replace-with-a-strong-random-secret"

# Canonical base URL used for SEO metadata, OpenGraph, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://indranicreations.store"

# Optional search console HTML meta tag verification codes.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Optional official social profile URLs (used in footer & Schema.org sameAs).
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_PINTEREST_URL=""

# Manual UPI checkout configuration.
NEXT_PUBLIC_UPI_VPA=""
NEXT_PUBLIC_UPI_MERCHANT_NAME="Indrani Creations"

# Optional customer support details shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""

# Vercel Blob token for product image uploads (optional locally; required in production).
BLOB_READ_WRITE_TOKEN=""

# Shared bearer secret for /api/cron/expire-orders (Vercel Cron & GitHub Actions).
CRON_SECRET=""
