// use prisma-next
types {
  Uuid = String @db.Uuid
}

enum UserRole {
  @@type("pg/text@1")

  CUSTOMER
  ADMIN
}

model User {
  id           Uuid     @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
