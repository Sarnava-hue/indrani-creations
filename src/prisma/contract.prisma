// use prisma-next
enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShippingStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           Int                        @id @default(autoincrement())
  email        String                     @unique
  passwordHash String
  name         String?
  phone        String?
  role         UserRole                   @default(CUSTOMER)

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
  cart         Cart?

  @@index([role])
}

model Address {
  id            Int                        @id @default(autoincrement())
  userId        Int

  label         String
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String
  countryCode   String                     @default("IN")

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  user          User                       @relation(fields:[userId], references:[id])

  @@index([userId])
}

model Category {
  id          Int                        @id @default(autoincrement())
  name        String
  slug        String                     @unique
  description String?
  imageUrl    String?

  parentId    Int?

  isActive    Boolean                    @default(true)
  sortOrder   Int                        @default(0)

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  parent      Category?                  @relation("CategoryHierarchy", fields:[parentId], references:[id])
  children    Category[]                 @relation("CategoryHierarchy")

  products    Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id                  Int                        @id @default(autoincrement())
  categoryId          Int

  name                String
  slug                String                     @unique
  sku                 String                     @unique
  shortDescription    String?
  description         String?

  pricePaise          Int
  compareAtPricePaise Int?

  fabric              String?
  color               String?
  occasion            String?
  pattern             String?
  sareeLength         String?
  blouseIncluded      Boolean                    @default(false)
  blouseDetails       String?
  careInstructions    String?

  isOneOfOne          Boolean                    @default(true)
  isActive            Boolean                    @default(true)
  isFeatured          Boolean                    @default(false)

  createdAt           TimestamptzString          @default(now())
  updatedAt           temporal.updatedAtString()

  category            Category                   @relation(fields:[categoryId], references:[id])
  images              ProductImage[]
  inventory           Inventory?
  cartItems           CartItem[]
  wishlistItems       WishlistItem[]
  orderItems          OrderItem[]
  reviews             Review[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProductImage {
  id        Int               @id @default(autoincrement())
  productId Int

  url       String
  altText   String?
  sortOrder Int               @default(0)
  isPrimary Boolean           @default(false)

  createdAt TimestamptzString @default(now())

  product   Product           @relation(fields:[productId], references:[id])

  @@index([productId, sortOrder])
}

model Inventory {
  id        Int                        @id @default(autoincrement())
  productId Int                        @unique

  quantity  Int                        @default(0)
  reserved  Int                        @default(0)

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  product   Product                    @relation(fields:[productId], references:[id])
}

model Cart {
  id        Int                        @id @default(autoincrement())
  userId    Int                        @unique

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  items     CartItem[]

  user      User                       @relation(fields:[userId], references:[id])
}

model CartItem {
  id        Int                        @id @default(autoincrement())
  cartId    Int
  productId Int

  quantity  Int                        @default(1)

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  cart      Cart                       @relation(fields:[cartId], references:[id])
  product   Product                    @relation(fields:[productId], references:[id])

  @@unique([cartId, productId])
  @@index([productId])
}

model WishlistItem {
  id        Int               @id @default(autoincrement())
  userId    Int
  productId Int

  createdAt TimestamptzString @default(now())

  user      User              @relation(fields:[userId], references:[id])
  product   Product           @relation(fields:[productId], references:[id])

  @@unique([userId, productId])
  @@index([productId])
}

model Order {
  id                    Int                        @id @default(autoincrement())
  userId                Int?

  orderNumber           String                     @unique

  customerEmail         String

  status                OrderStatus                @default(PENDING) @default(PENDING)
  paymentStatus         PaymentStatus              @default(PENDING)
  shippingStatus        ShippingStatus             @default(PENDING)

  currency              String                     @default("INR")

  subtotalPaise         Int
  discountPaise         Int                        @default(0)
  shippingPaise         Int                        @default(0)
  taxPaise              Int                        @default(0)
  totalPaise            Int

  couponId              Int?

  shippingRecipientName String
  shippingPhone         String
  shippingLine1         String
  shippingLine2         String?
  shippingCity          String
  shippingState         String
  shippingPostalCode    String
  shippingCountryCode   String                     @default("IN")

  customerNote          String?

  createdAt             TimestamptzString          @default(now())
  updatedAt             temporal.updatedAtString()

  user                  User?                      @relation(fields:[userId], references:[id])
  coupon                Coupon?                    @relation(fields:[couponId], references:[id])
  items                 OrderItem[]
  payment               Payment?
  shipment              Shipment?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingStatus])
  @@index([couponId])
  @@index([createdAt])
}

model OrderItem {
  id             Int               @id @default(autoincrement())
  orderId        Int
  productId      Int

  productName    String
  sku            String

  unitPricePaise Int
  quantity       Int
  totalPaise     Int

  createdAt      TimestamptzString @default(now())

  order          Order             @relation(fields:[orderId], references:[id])
  product        Product           @relation(fields:[productId], references:[id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                Int                        @id @default(autoincrement())
  orderId           Int                        @unique

  provider          String
  providerOrderId   String?
  providerPaymentId String?

  amountPaise       Int
  currency          String                     @default("INR")

  status            PaymentStatus              @default(PENDING)

  paidAt            TimestamptzString?
  failureCode       String?
  failureNote       String?

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  order             Order                      @relation(fields:[orderId], references:[id])

  @@index([providerPaymentId])
  @@index([status])
}

model Shipment {
  id                 Int                        @id @default(autoincrement())
  orderId            Int                        @unique

  provider           String?
  providerShipmentId String?
  trackingNumber     String?
  trackingUrl        String?

  status             ShippingStatus             @default(PENDING)

  shippedAt          TimestamptzString?
  deliveredAt        TimestamptzString?

  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  order              Order                      @relation(fields:[orderId], references:[id])

  @@index([trackingNumber])
  @@index([status])
}

model Coupon {
  id                   Int                        @id @default(autoincrement())

  code                 String                     @unique

  discountType         DiscountType
  discountValue        Int

  minimumOrderPaise    Int?
  maximumDiscountPaise Int?

  usageLimit           Int?
  usageCount           Int                        @default(0)
  perUserLimit         Int?

  startsAt             TimestamptzString?
  expiresAt            TimestamptzString?

  isActive             Boolean                    @default(true)

  createdAt            TimestamptzString          @default(now())
  updatedAt            temporal.updatedAtString()

  orders               Order[]

  @@index([isActive])
  @@index([expiresAt])
}

model Review {
  id        Int                        @id @default(autoincrement())
  userId    Int
  productId Int

  rating    Int
  title     String?
  comment   String?

  status    ReviewStatus               @default(PENDING)

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  user      User                       @relation(fields:[userId], references:[id])
  product   Product                    @relation(fields:[productId], references:[id])

  @@unique([userId, productId])
  @@index([productId, status])
}

model PaymentEvent {
  id Int @id @default(autoincrement())

  provider String
  eventId  String

  eventType String

  paymentId Int?

  payload String

  createdAt TimestamptzString @default(now())

  @@unique([provider, eventId])
  @@index([paymentId])
  @@index([eventType])
}